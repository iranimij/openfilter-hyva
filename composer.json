{
    "name": "iranimij/openfilter-hyva",
    "description": "OpenFilter render package for Hyvä themes: filter templates, one Alpine component for same-URL AJAX, mobile drawer, sliders and structural CSS. No Tailwind rebuild needed.",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": [
        "magento2",
        "mage-os",
        "hyva",
        "layered-navigation",
        "ajax-filters",
        "openfilter"
    ],
    "homepage": "https://github.com/iranimij/openfilter-hyva",
    "support": {
        "issues": "https://github.com/iranimij/openfilter-hyva/issues",
        "source": "https://github.com/iranimij/openfilter-hyva",
        "docs": "https://github.com/iranimij/openfilter/tree/main/docs"
    },
    "authors": [
        {
            "name": "Iman Aboheydary",
            "homepage": "https://github.com/iranimij"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "hyva-themes/magento2-theme-module": "^1.3",
        "iranimij/module-base": "^1.0",
        "iranimij/openfilter": "^1.0",
        "magento/framework": "^103.0.7",
        "magento/module-catalog": "^104.0.7",
        "magento/module-catalog-search": "^102.0.7",
        "magento/module-layered-navigation": "^100.4.7",
        "magento/module-store": "^101.1.7"
    },
    "suggest": {
        "hyva-themes/magento2-default-theme": "The Hyvä default theme (1.4 or 1.5) this package renders into"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Iranimij\\OpenFilterHyva\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "iranimij": {
            "changelog": "https://github.com/iranimij/openfilter-hyva/blob/main/CHANGELOG.md"
        }
    },
    "config": {
        "sort-packages": true
    }
}
