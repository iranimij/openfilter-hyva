declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Iranimij\OpenFilter\ViewModel\Data\FilterGroup;
use Iranimij\OpenFilter\ViewModel\Debug;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/**
 * One filter as a native disclosure (works without JavaScript, no layout shift). The options come from the child
 * block named after the display mode (list, swatch, slider, rating, toggle, category, dropdown, images), "list" as
 * fallback.
 *
 * @var Template $block
 * @var Escaper $escaper
 * @var ViewModelRegistry $viewModels
 */
/** @var FilterGroup $group */
$group = $block->getData('group');
// The filter key is unique (an attribute named like a built-in filter has the key "attribute:<code>").
$ident = (string) ($group->getKey() ?? $group->getCode());
$id = 'of-group-' . preg_replace('/[^a-z0-9_-]/i', '-', $ident);
$options = $block->getChildBlock($group->getDisplay()) ?: $block->getChildBlock('list');
$selected = $group->getSelectedCount();
$debug = $viewModels->require(Debug::class);
?>
<details class="of-group of-group--<?= $escaper->escapeHtmlAttr($group->getDisplay()) ?>"
         data-of-group="<?= $escaper->escapeHtmlAttr($ident) ?>"<?= $group->isExpanded() ? ' open' : '' ?>
         <?= /* @noEscape */ $debug->group($group) ?>>
    <summary class="of-group__title" id="<?= $escaper->escapeHtmlAttr($id) ?>-title">
        <span class="of-group__label"><?= $escaper->escapeHtml($group->getLabel()) ?></span>
        <?php if ($selected > 0): ?>
            <span class="of-group__active"><?= $escaper->escapeHtml(__('%1 selected', $selected)) ?></span>
        <?php endif; ?>
    </summary>
    <div class="of-group__body" id="<?= $escaper->escapeHtmlAttr($id) ?>">
        <?php /* "Match all" is one line; a merchant tooltip next to it opens on demand, alone it stays in view. */ ?>
        <?php if ($group->isMatchAll()): ?>
            <p class="of-group__hint">
                <span class="of-group__match"><?= $escaper->escapeHtml(__('Products have all picked values.')) ?></span>
            </p>
            <?php if ($group->getTooltip() !== null): ?>
                <details class="of-about">
                    <summary><?= $escaper->escapeHtml(__('About %1', $group->getLabel())) ?></summary>
                    <p class="of-group__hint"><?= $escaper->escapeHtml((string) $group->getTooltip()) ?></p>
                </details>
            <?php endif; ?>
        <?php elseif ($group->getTooltip() !== null): ?>
            <p class="of-group__hint"><?= $escaper->escapeHtml((string) $group->getTooltip()) ?></p>
        <?php endif; ?>
        <?= /* @noEscape */ $options ? $options->setData('group', $group)->setData('group_id', $id)->toHtml() : '' ?>
    </div>
</details>
