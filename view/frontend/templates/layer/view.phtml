declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Iranimij\OpenFilter\Model\Config;
use Iranimij\OpenFilter\ViewModel\Debug;
use Iranimij\OpenFilter\ViewModel\FilterBlock;
use Iranimij\OpenFilterHyva\ViewModel\Ajax;
use Magento\Framework\Escaper;
use Magento\LayeredNavigation\Block\Navigation;

/**
 * OpenFilter's filter region (#of-filters): one disclosure per filter, real links underneath. It sits in a <dialog>
 * that is open in place (the sidebar, and every layout without JavaScript); on phones the AJAX component shows it as
 * a modal drawer (08 §3, 10 FE8) with staged changes and "Show N products". The dialog is outside the swapped
 * region, so the drawer stays open while its filters update.
 *
 * @var Navigation $block
 * @var Escaper $escaper
 * @var ViewModelRegistry $viewModels
 */
$filterBlock = $viewModels->require(FilterBlock::class);
$groups = $block->canShowBlock() ? $filterBlock->groups($block->getFilters()) : [];
$renderer = $block->getChildBlock('of_group');
$ajax = $viewModels->require(Ajax::class)->isEnabled();
$debug = $viewModels->require(Debug::class);
?>
<?php
// Fixed class names: printed as they are, so the 1.0 markup stays the same ("of-drawer of-drawer--js").
$classes = ['of-drawer'];
if ($ajax) {
    $classes[] = 'of-drawer--js';
}
if ($filterBlock->layout() === Config::LAYOUT_HORIZONTAL) {
    $classes[] = 'of-drawer--horizontal';
}
if ($filterBlock->isSticky()) {
    $classes[] = 'of-drawer--sticky';
}
$applyButton = $ajax && $filterBlock->applyMode() === Config::APPLY_BUTTON;
?>
<dialog id="of-drawer" class="<?= /* @noEscape */ implode(' ', $classes) ?>" open aria-labelledby="of-filters-title"
        data-of-show="<?= $escaper->escapeHtmlAttr(__('Show %1 products', '%1')) ?>"
        data-of-show-one="<?= $escaper->escapeHtmlAttr(__('Show 1 product')) ?>">
    <?php if ($ajax): ?>
        <div class="of-drawer__head">
            <span class="of-drawer__title"><?= $escaper->escapeHtml(__('Filters')) ?></span>
            <button type="button" class="of-drawer__close" data-of-drawer-close
                    aria-label="<?= $escaper->escapeHtmlAttr(__('Close filters')) ?>">×</button>
        </div>
    <?php endif; ?>
    <div id="of-filters" class="of-filters" data-of-region="filters"<?= /* @noEscape */ $debug->region() ?>>
    <?php /* The dialog's accessible name: printed on every page, visually hidden when there are no filters. */ ?>
    <h2 id="of-filters-title" class="of-filters__title<?= $groups === [] ? ' of-sr' : '' ?>">
        <?= $escaper->escapeHtml(__('Shop By')) ?>
    </h2>
    <?php if ($groups !== [] && $renderer): ?>
        <nav class="of-filters__nav" aria-labelledby="of-filters-title">
            <?php foreach ($groups as $group): ?>
                <?= /* @noEscape */ $renderer->setData('group', $group)->toHtml() ?>
            <?php endforeach; ?>
        </nav>
    <?php endif; ?>
    </div>
    <?php if ($applyButton): ?>
        <?php /* Desktop apply mode (1.1, js/extras.phtml): staged filters, then one swap. */ ?>
        <div class="of-apply" data-of-apply-bar hidden>
            <a class="of-apply__reset" href="#" data-of-apply-reset><?= $escaper->escapeHtml(__('Reset')) ?></a>
            <button type="button" class="of-apply__show" data-of-apply-show></button>
        </div>
    <?php endif; ?>
    <?php if ($ajax): ?>
        <div class="of-drawer__foot">
            <a class="of-drawer__clear" href="#" data-of-drawer-clear><?= $escaper->escapeHtml(__('Clear all')) ?></a>
            <button type="button" class="of-drawer__apply" data-of-drawer-apply></button>
        </div>
    <?php endif; ?>
</dialog>
