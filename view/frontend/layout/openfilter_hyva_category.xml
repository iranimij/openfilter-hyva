<!--
Layered category pages on a Hyvä theme with OpenFilter enabled (Observer\AddLayerHandles). Three regions the AJAX
layer swaps: #of-filters (the leftnav template's root), #of-state (the state template's root, moved above the
results) and #of-results (a container around the product list block, so empty results are covered too).
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="catalog.leftnav">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Iranimij_OpenFilterHyva::layer/view.phtml</argument>
            </action>
            <!-- Options per display mode: a child named after the mode (FilterGroup::getDisplay()), "list" as fallback. -->
            <block class="Magento\Framework\View\Element\Template" name="openfilter.category.group" as="of_group"
                   template="Iranimij_OpenFilterHyva::layer/group.phtml">
                <block class="Magento\Framework\View\Element\Template" name="openfilter.category.filter.list" as="list"
                       template="Iranimij_OpenFilterHyva::layer/filter/list.phtml"/>
                <block class="Magento\Framework\View\Element\Template" name="openfilter.category.filter.swatch" as="swatch"
                       template="Iranimij_OpenFilterHyva::layer/filter/swatch.phtml"/>
                <block class="Magento\Framework\View\Element\Template" name="openfilter.category.filter.rating" as="rating"
                       template="Iranimij_OpenFilterHyva::layer/filter/rating.phtml"/>
                <block class="Magento\Framework\View\Element\Template" name="openfilter.category.filter.toggle" as="toggle"
                       template="Iranimij_OpenFilterHyva::layer/filter/toggle.phtml"/>
                <block class="Magento\Framework\View\Element\Template" name="openfilter.category.filter.category" as="category"
                       template="Iranimij_OpenFilterHyva::layer/filter/category.phtml"/>
                <block class="Magento\Framework\View\Element\Template" name="openfilter.category.filter.slider" as="slider"
                       template="Iranimij_OpenFilterHyva::layer/filter/slider.phtml"/>
                <block class="Magento\Framework\View\Element\Template" name="openfilter.category.filter.from_to" as="from_to"
                       template="Iranimij_OpenFilterHyva::layer/filter/slider.phtml"/>
                <block class="Magento\Framework\View\Element\Template" name="openfilter.category.filter.dropdown" as="dropdown"
                       template="Iranimij_OpenFilterHyva::layer/filter/dropdown.phtml"/>
                <block class="Magento\Framework\View\Element\Template" name="openfilter.category.filter.images" as="images"
                       template="Iranimij_OpenFilterHyva::layer/filter/swatch.phtml"/>
            </block>
        </referenceBlock>
        <referenceBlock name="catalog.navigation.state">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Iranimij_OpenFilterHyva::layer/state.phtml</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <container name="openfilter.category.results" htmlTag="div" htmlId="of-results" htmlClass="of-results"
                       before="category.products">
                <!-- After the product list: counting earlier would search before the toolbar's sort and page. -->
                <block class="Magento\Framework\View\Element\Template" name="openfilter.category.count"
                       template="Iranimij_OpenFilterHyva::layer/count.phtml"/>
            </container>
        </referenceContainer>
        <move element="category.products" destination="openfilter.category.results" before="openfilter.category.count"/>
        <move element="catalog.navigation.state" destination="content" before="openfilter.category.results"/>
    </body>
</page>
