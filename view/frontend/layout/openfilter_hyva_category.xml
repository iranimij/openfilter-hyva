<!--
Layered category pages on a Hyvä theme with OpenFilter enabled (Observer\AddLayerHandles). Three regions the AJAX
layer swaps: #of-filters (the leftnav template's root), #of-state (the state template's root, moved above the
results) and #of-results (a container around the product list block, so empty results are covered too).
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="catalog.leftnav">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Iranimij_OpenFilterHyva::layer/view.phtml</argument>
            </action>
            <block class="Magento\Framework\View\Element\Template" name="openfilter.category.group" as="of_group"
                   template="Iranimij_OpenFilterHyva::layer/group.phtml">
                <block class="Magento\Framework\View\Element\Template" name="openfilter.category.filter.list" as="list"
                       template="Iranimij_OpenFilterHyva::layer/filter/list.phtml"/>
            </block>
        </referenceBlock>
        <referenceBlock name="catalog.navigation.state">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Iranimij_OpenFilterHyva::layer/state.phtml</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <container name="openfilter.category.results" htmlTag="div" htmlId="of-results" htmlClass="of-results"
                       before="category.products"/>
        </referenceContainer>
        <move element="category.products" destination="openfilter.category.results"/>
        <move element="catalog.navigation.state" destination="content" before="openfilter.category.results"/>
    </body>
</page>
